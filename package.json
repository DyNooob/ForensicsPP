{
  "name": "forensicspp",
  "version": "1.0.0-beta.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DyNooob/ForensicsPP.git"
  },
  "homepage": "https://www.forensicspp.com/",
  "bugs": {
    "url": "https://github.com/DyNooob/ForensicsPP/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "clean": "node scripts/clean-dist.mjs",
    "check:headers": "node scripts/copyright-headers.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:dist": "node scripts/verify-dist.mjs",
    "release:package": "node scripts/package-release.mjs",
    "build": "npm run clean && npm run check:headers && npm run typecheck && vite build && node scripts/finalize-dist.mjs && npm run verify:dist",
    "verify": "npm run test && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "audit:layout": "node scripts/layout-audit.mjs",
    "audit:contact-sheet": "python3 scripts/make-contact-sheet.py",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@ts-evtx/core": "^1.2.0",
    "@virustotal/yara-x": "^1.15.0",
    "@vitejs/plugin-react": "^5.1.1",
    "antd": "^5.29.3",
    "bcryptjs": "^3.0.3",
    "cfb": "^1.2.2",
    "crypto-js": "^4.2.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.1.200",
    "postal-mime": "^2.7.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sm-crypto": "^0.4.0",
    "sql-formatter": "^15.8.2",
    "sql.js": "^1.14.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@rc-component/qrcode": "^1.1.3",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "vitest": "^4.1.7",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.0"
  }
}
