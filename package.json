{
  "name": "forensicspp",
  "version": "1.0.0-beta.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DyNooob/ForensicsPP.git"
  },
  "homepage": "https://www.forensicspp.com/",
  "bugs": {
    "url": "https://github.com/DyNooob/ForensicsPP/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "clean": "node scripts/clean-dist.mjs",
    "check:headers": "node scripts/copyright-headers.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:dist": "node scripts/verify-dist.mjs",
    "release:package": "node scripts/package-release.mjs",
    "build": "npm run clean && npm run check:headers && npm run typecheck && vite build && node scripts/finalize-dist.mjs && npm run verify:dist",
    "verify": "npm run test && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "audit:layout": "node scripts/layout-audit.mjs",
    "audit:contact-sheet": "python3 scripts/make-contact-sheet.py"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@ts-evtx/core": "^1.2.0",
    "@virustotal/yara-x": "^1.19.0",
    "@vitejs/plugin-react": "^6.0.5",
    "antd": "^6.5.2",
    "bcryptjs": "^3.0.3",
    "cfb": "^1.2.2",
    "crypto-js": "^4.2.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.2.108",
    "postal-mime": "^2.7.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sm-crypto": "^0.5.3",
    "sql-formatter": "^15.8.2",
    "sql.js": "^1.14.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@rc-component/qrcode": "^1.1.3",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "vitest": "^4.1.7"
  }
}
